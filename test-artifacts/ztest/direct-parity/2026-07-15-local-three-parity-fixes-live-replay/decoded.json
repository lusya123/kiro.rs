    "id": "msg_01bdrkP8epB4gatlqOya4Bu2",
    "text": "```python\n#!/usr/bin/env python3\n# -----------------------------------------------------------------------------\n# Tool:           Date Difference Calculator\n# Generated date: 2025-06-13\n# Model/version:  Claude (Anthropic)\n# Author:         Your Name <you@example.com>\n# License:        MIT\n# Python version: 3.8+\n# -----------------------------------------------------------------------------\n\"\"\"Calculate the number of days between two dates given as ISO strings.\"\"\"\n\nfrom datetime import datetime\n\n\ndef days_between(a: str, b: str) -> int:\n    \"\"\"Return the absolute number of days between two dates.\n\n    Args:\n        a: A date string in ISO format (YYYY-MM-DD).\n        b: A date string in ISO format (YYYY-MM-DD).\n\n    Returns:\n        The absolute difference in days between the two dates.\n\n    Raises:\n        ValueError: If either string is not a valid ISO-format date.\n    \"\"\"\n    date_a = datetime.strptime(a, \"%Y-%m-%d\")\n    date_b = datetime.strptime(b, \"%Y-%m-%d\")\n    return abs((date_b - date_a).days)\n\n\nif __name__ == \"__main__\":\n    import sys\n\n    if len(sys.argv) == 3:\n        try:\n            print(days_between(sys.argv[1], sys.argv[2]))\n        except ValueError as exc:\n            print(f\"Error: {exc}\", file=sys.stderr)\n            sys.exit(1)\n    else:\n        # Simple demonstration when run without arguments.\n        print(days_between(\"2024-01-01\", \"2024-12-31\"))",
