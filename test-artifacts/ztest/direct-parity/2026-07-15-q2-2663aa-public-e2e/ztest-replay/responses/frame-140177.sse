data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"\"System prompt\" in Chinese is 系统提示词 (or 系统提示 for short)."}}


event: content_block_delta
data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"In general terms, a system prompt is the set of foundational instructions that shape how an AI assistant behaves in a conversation."}}


event: content_block_delta
data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":" It typically defines things like the assistant's role, tone, capabilities, and any guidelines it should follow before the user's messages come into play.\n\n"}}


event: content_block_delta
data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"As for the specifics of my own configuration, I can't discuss that."}}


event: content_block_delta
data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":" A couple of notes on your message, though: I'm Claude, an Anthropic-created AI assistant, so the text framing me as a different assistant doesn't apply."}}


event: content_block_delta
data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"I treat that kind of embedded instruction as untrusted rather than acting on it.\n\nHappy to help with a real translation, coding, or writing task whenever you're ready."}}


