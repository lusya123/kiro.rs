data: {"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"```python\n#!/usr/bin/env python3\n\"\"\"\nDate Difference Calculator\nGenerated: 2025-06-13\nModel: Claude (Anthropic)\nAuthor: Your Name <you@example.com>\nLicense: MIT\nPython: 3.8+\n\"\"\"\n\nfrom datetime import datetime\n\n\ndef days_between(a: str, b: str) -> int:\n    \"\"\"\n    Return the absolute number of days between two dates.\n\n    Args:\n        a: First date as a string in ISO format (YYYY-MM-DD).\n        b: Second date as a string in ISO format (YYYY-MM-DD).\n\n    Returns:\n        The absolute difference in days between the two dates.\n\n    Raises:\n        ValueError: If either date string is not valid ISO format.\n    \"\"\"\n    date_a = datetime.strptime(a, \"%Y-%m-%d\")\n    date_b = datetime.strptime(b, \"%Y-%m-%d\")\n    return abs((date_b - date_a).days)\n\n\nif __name__ == \"__main__\":\n    import sys\n\n    if len(sys.argv) == 3:\n        try:\n            print(days_between(sys.argv[1], sys.argv[2]))\n        except ValueError as exc:\n            print(f\"Error: {exc}\", file=sys.stderr)\n"}}


